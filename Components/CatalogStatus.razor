@inject Michiyuki.Models.TripPlanner Planner

@if (Planner.LoadError is null)
{
    <section class="mx-auto max-w-3xl px-6 py-24" aria-live="polite" aria-busy="true">
        <p class="eyebrow">LOADING</p>
        <p class="mt-3 text-lg text-muted">Fetching the timetable from Supabase...</p>
    </section>
}
else
{
    <section class="mx-auto max-w-3xl px-6 py-24" role="alert">
        <h1 class="text-4xl">Could not reach the database</h1>
        <p class="mt-3 text-muted">@Planner.LoadError</p>
        <p class="mt-3 text-muted">Check Supabase:Url and Supabase:Key in appsettings.json, that schema.sql and seed.sql were run, and that the project is not paused. Then reload the page.</p>
    </section>
}