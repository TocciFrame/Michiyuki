@page "/"
@rendermode InteractiveServer
@inject TripPlanner Planner

<PageTitle>Michiyuki: small-group travel across Japan, planned as a rail line</PageTitle>

<section class="home-hero mx-auto grid max-w-6xl gap-10 px-5 pt-8 md:px-8 lg:grid-cols-[5fr_6fr] lg:gap-14 lg:pt-14">
    <div class="lg:pt-4">
        <p class="eyebrow">A FIELD GUIDE TO JAPAN <span aria-hidden="true">✳</span> 道行</p>
        <h1 class="hero-title text-[clamp(2.6rem,7.2vw,5.2rem)]">Find your own way through Japan.</h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
            From Hokkaido’s lavender fields to Okinawa’s clear-water coast, build a small-group journey around places worth slowing down for.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/explore" class="btn-signal">Start your route</a>
            <a href="/seasons" class="btn-outline">See what is in season</a>
        </div>

        <div class="season-peek mt-10 border-t-2 border-ink pt-5">
            <p class="font-bold">A few good reasons to go in @MonthName</p>
            @if (inSeason.Count == 0)
            {
                <p class="mt-2 text-muted">A quiet month on the line. Indoor workshops are the safe bet.</p>
            }
            else
            {
                <ul class="mt-3 flex flex-wrap gap-2">
                    @foreach (var d in inSeason)
                    {
                        <li>
                            <a href="/explore?station=@d.Id" class="sign hover:bg-accent" data-region="@d.Region" aria-label="@d.Name, station @d.Code">
                                <span class="sign-code">@d.Code</span><span class="sign-name">@d.Name</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div>
        <div class="linemap" role="group" aria-label="Interactive destination line map from Hokkaido in the north through Japan to Okinawa in the south. Select a station for details.">
            <svg class="trunk" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @for (var i = 0; i < stations.Count - 1; i++)
                {
                    var a = stations[i]; var b = stations[i + 1];
                    <line class="seg" data-region="@b.Region" x1="@a.MapX" y1="@a.MapY" x2="@b.MapX" y2="@b.MapY" />
                }
            </svg>
            @for (var i = 0; i < stations.Count; i++)
            {
                var d = stations[i];
                <div class="station" style="left:@(d.MapX)%;top:@(d.MapY)%;--i:@i">
                    <button type="button" class="station-btn" data-region="@d.Region"
                            aria-pressed="@(selected.Id == d.Id ? "true" : "false")"
                            aria-label="@d.Name, station @d.Code"
                            @onclick="() => selected = d">
                        <span>@d.Code</span>
                    </button>
                    <span class="station-label @(d.LabelLeft ? "left" : "right")" aria-hidden="true">@d.Name</span>
                </div>
            }
        </div>

        <div class="selected-location mt-4 border-2 border-ink bg-surface p-5" aria-live="polite">
            <img class="selected-location-photo" src="@selected.PhotoUrl" alt="@selected.PhotoAlt" loading="lazy" referrerpolicy="no-referrer" />
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <span class="sign sign-lg" data-region="@selected.Region">
                    <span class="sign-code">@selected.Code</span><span class="sign-name">@selected.Name</span>
                </span>
                <span lang="ja" class="font-display text-2xl font-extrabold">@selected.JpName</span>
                <span class="badge" data-region="@selected.Region">@selected.Region.Label() line, @selected.Prefecture</span>
            </div>
            <p class="mt-3 max-w-prose text-muted">@selected.Blurb</p>
            <p class="mt-3">
                <a class="btn-line" href="/explore?station=@selected.Id">
                    @selectedCount @(selectedCount == 1 ? "experience" : "experiences") here, from @selectedFrom.Yen() per person
                </a>
            </p>
        </div>
    </div>
</section>

<section class="destination-section mx-auto mt-24 max-w-6xl px-5 md:px-8" aria-labelledby="destinations-h">
    <div class="section-heading flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="eyebrow">01 / CHOOSE YOUR LANDSCAPE</p>
            <h2 id="destinations-h" class="mt-3 text-3xl md:text-4xl">Ten places. A thousand ways to feel Japan.</h2>
        </div>
        <p class="max-w-sm text-muted">Browse the line by feeling, not just by distance — snowy streets, old craft towns, mountain forests and islands.</p>
    </div>

    <div class="destination-grid mt-8">
        @foreach (var d in stations)
        {
            <a class="destination-card" data-region="@d.Region" href="/explore?station=@d.Id" aria-label="Explore @d.Name, @d.Prefecture">
                <div class="destination-photo-wrap">
                    <img class="destination-photo" src="@d.PhotoUrl" alt="@d.PhotoAlt" loading="lazy" referrerpolicy="no-referrer" />
                    <span class="destination-code">@d.Code</span>
                    <span class="destination-region">@d.Region.Label()</span>
                </div>
                <div class="destination-copy">
                    <div class="destination-title-line">
                        <h3>@d.Name</h3>
                        <span lang="ja" class="destination-jp">@d.JpName</span>
                    </div>
                    <p>@d.Blurb</p>
                    <span class="destination-link">Explore this stop <span aria-hidden="true">↗</span></span>
                </div>
            </a>
        }
    </div>
</section>

<section class="mx-auto mt-20 max-w-6xl px-5 md:px-8" aria-labelledby="board-h">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="eyebrow">02 / DEPARTURE BOARD</p>
            <h2 id="board-h" class="mt-3 text-3xl md:text-4xl">Filling up first</h2>
        </div>
        <p class="hint max-w-xs">Seats left per experience, priced for a party of @Planner.Travelers.</p>
    </div>
    <div class="board on-ink mt-6">
        <div class="board-row hidden text-sm font-bold text-board-muted md:grid" aria-hidden="true">
            <span>Station</span><span>Experience</span><span>Type</span><span>Length</span><span>Seats</span><span class="text-right">Per person</span>
        </div>
        <ul>
            @foreach (var e in filling)
            {
                <li>
                    <a class="board-row" href="/explore?station=@e.Destination.Id">
                        <span class="sign" data-region="@e.Region"><span class="sign-code">@e.Destination.Code</span></span>
                        <span>
                            <span class="block font-bold">@e.Name</span>
                            <span class="block text-sm text-board-muted">@e.Destination.Name</span>
                            <span class="mt-1 flex flex-wrap gap-x-3 text-sm text-board-muted md:hidden">
                                <span>@e.Kind.Label()</span><span>@e.Days @(e.Days == 1 ? "day" : "days")</span><span>@e.CostPerPerson(Planner.Travelers).Yen() each</span>
                            </span>
                        </span>
                        <span class="hidden text-board-muted md:block">@e.Kind.Label()</span>
                        <span class="hidden md:block">@e.Days @(e.Days == 1 ? "day" : "days")</span>
                        <span class="@(e.SeatsLeft <= 3 ? "seats-low" : "") text-right md:text-left">@(e.IsFull ? "Full" : $"{e.SeatsLeft} left")</span>
                        <span class="hidden text-right font-bold md:block">@e.CostPerPerson(Planner.Travelers).Yen()</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

<section class="how-section mx-auto mt-24 grid max-w-6xl gap-10 px-5 md:px-8 lg:grid-cols-[4fr_7fr]" aria-labelledby="how-h">
    <div>
        <p class="eyebrow">03 / YOUR JOURNEY, YOUR RULES</p>
        <h2 id="how-h" class="mt-3 text-3xl md:text-4xl">How a route gets built</h2>
        <p class="mt-4 max-w-sm text-muted">Nothing is held for you until the last step, so you can add, drop and re-price as often as you like.</p>
    </div>
    <ol class="relative border-l-4 border-ink pl-8">
        <li class="relative pb-10">
            <span class="absolute -left-[3.05rem] grid h-9 w-9 place-items-center rounded-full border-4 border-ink bg-paper font-extrabold" aria-hidden="true">1</span>
            <h3 class="text-xl">Add stops from the board</h3>
            <p class="mt-1 max-w-lg text-muted">Filter by line, season or price. Each experience shows what the price covers and how many seats are left.</p>
        </li>
        <li class="relative pb-10">
            <span class="absolute -left-[3.05rem] grid h-9 w-9 place-items-center rounded-full border-4 border-ink bg-paper font-extrabold" aria-hidden="true">2</span>
            <h3 class="text-xl">Set the size of your party</h3>
            <p class="mt-1 max-w-lg text-muted">Walks get cheaper from four people, rooms are priced in pairs, and shared fees are split for you.</p>
        </li>
        <li class="relative">
            <span class="absolute -left-[3.05rem] grid h-9 w-9 place-items-center rounded-full border-4 border-ink bg-accent font-extrabold" aria-hidden="true">3</span>
            <h3 class="text-xl">Confirm and take your ticket</h3>
            <p class="mt-1 max-w-lg text-muted">Pick a departure at least two weeks out. Seats are reserved on every stop at once, or on none.</p>
        </li>
    </ol>
</section>

<section class="fine-print mx-auto mt-24 max-w-6xl px-5 md:px-8" aria-label="Fine print">
    <dl class="grid border-2 border-ink bg-surface md:grid-cols-3 md:divide-x-2 md:divide-ink">
        <div class="border-b-2 border-ink p-5 md:border-b-0">
            <dt class="font-display text-lg font-extrabold">Twelve at most</dt>
            <dd class="mt-1 text-sm text-muted">Every experience caps its group, and no route books more than twelve travelers.</dd>
        </div>
        <div class="border-b-2 border-ink p-5 md:border-b-0">
            <dt class="font-display text-lg font-extrabold">Prices follow the party</dt>
            <dd class="mt-1 text-sm text-muted">Totals are recalculated from the model for your exact headcount, not a "from" price.</dd>
        </div>
        <div class="p-5">
            <dt class="font-display text-lg font-extrabold">Yen, no surprises</dt>
            <dd class="mt-1 text-sm text-muted">Fees are listed line by line in each experience's cost breakdown.</dd>
        </div>
    </dl>
</section>

@code {
    private readonly IReadOnlyList<Destination> stations = SampleData.Destinations;
    private Destination selected = default!;
    private List<Destination> inSeason = new();
    private List<Experience> filling = new();

    private string MonthName => CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(DateTime.Now.Month);

    private int selectedCount => Planner.Catalog.Count(e => e.Destination.Id == selected.Id);
    private decimal selectedFrom => Planner.Catalog
        .Where(e => e.Destination.Id == selected.Id)
        .Select(e => e.CostPerPerson(Planner.Travelers))
        .DefaultIfEmpty(0).Min();

    protected override void OnInitialized()
    {
        var month = DateTime.Now.Month;
        inSeason = stations.Where(d => d.IsInSeason(month)).ToList();
        selected = inSeason.FirstOrDefault() ?? stations[0];
        filling = Planner.Catalog.OrderBy(e => e.SeatsLeft).ThenBy(e => e.Id).Take(6).ToList();
    }
}
